<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meta Ads Growth Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet">
    <style>
        body { background: #020406; color: #e5e7eb; font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-card { background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .btn-gradient { background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-6">

    <div class="max-w-4xl w-full text-center">
        <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6">The Meta Ads <span class="text-blue-500">Vault.</span></h1>
        
        <div class="glass-card p-12 rounded-[2.5rem] shadow-2xl">
            <h3 class="text-xl font-bold text-white mb-8">Test Connection</h3>
            
            <form id="vaultForm" class="flex flex-col md:flex-row gap-4">
                <input type="text" id="userName" name="name" required placeholder="First Name" 
                       class="bg-white/5 border border-white/10 px-6 py-4 rounded-2xl w-full text-white focus:outline-none focus:border-blue-500">
                
                <input type="email" id="userEmail" name="email" required placeholder="Email" 
                       class="bg-white/5 border border-white/10 px-6 py-4 rounded-2xl w-full text-white focus:outline-none focus:border-blue-500">
                
                <button type="submit" id="submitBtn" class="btn-gradient text-white px-10 py-4 rounded-2xl font-bold transition-all hover:scale-105">
                    Unlock Now
                </button>
            </form>
            <p id="statusMsg" class="mt-4 text-sm"></p>
        </div>
    </div>

    <script>
        const form = document.getElementById('vaultForm');
        const btn = document.getElementById('submitBtn');
        const msg = document.getElementById('statusMsg');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // 1. YOUR WEBHOOK URL GOES HERE (Must start with https://)
            const webhookUrl = 'https://hook.us2.make.com/8u0xa02mrqegyx443mug8z5fxwf9aa2a'; 

            const data = {
                name: document.getElementById('userName').value,
                email: document.getElementById('userEmail').value,
                source: 'Meta Vault Test'
            };

            btn.innerText = 'Connecting...';
            btn.disabled = true;

            try {
                const response = await fetch(webhookUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    btn.innerText = 'Success!';
                    btn.style.background = '#059669';
                    msg.innerText = 'Data caught by Make.com!';
                    msg.style.color = '#059669';
                } else {
                    throw new Error('Server returned ' + response.status);
                }
            } catch (err) {
                console.error(err);
                btn.innerText = 'Error';
                btn.disabled = false;
                msg.innerText = 'Failed: ' + err.message;
                msg.style.color = '#ef4444';
            }
        });
    </script>
</body>
</html>
